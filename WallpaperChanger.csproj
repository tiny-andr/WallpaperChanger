<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WallpaperChanger</AssemblyName>
    <RootNamespace>WallpaperChanger</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.0.3</Version>
    <!-- The SDK appends "+<git-sha>" to InformationalVersion when the repo
         has a .git dir (SourceLink). ProductVersion then shows garbage like
         "0.0.2+3f2a9c1..." in the window/help titles. Disable it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>local</Company>
    <Product>WallpaperChanger</Product>
  </PropertyGroup>

</Project>
